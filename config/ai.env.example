# =============================================================================
# Malcolm AI configuration
# =============================================================================

# === AI feature toggles ===
AI_ENABLED=true
# AI_EXECUTE_ENABLED gates the /ai/v1/execute endpoint — leave false until trusted
AI_EXECUTE_ENABLED=false
AI_EXECUTE_RATE_LIMIT=30

# === AI engine config ===
# AI_DEFAULT_MODEL must match a YAML name under api/project/ai/config/models/.
# The provider for the chosen model decides which env vars below are required.
#
# Common choices:
#   llama-3_2-3b              ollama, small (3B), good default for local dev
#   ollama-llama-3_1-8b       ollama, parameterized via OLLAMA_MODEL
#   ollama-phi4               ollama, 14B, heavier reasoning
#   anthropic-claude-haiku    cloud, fast tool routing
#   anthropic-claude-sonnet   cloud, heavier reasoning
#   openai-gpt-5_4-mini       cloud, fast tool routing
#   openai-gpt-5_4            cloud, heavier reasoning
AI_DEFAULT_MODEL=llama-3_2-3b
AI_SAFETY_MODE=single          # single | two_step | disabled
AI_ROUTER_MODEL=               # only used in two_step mode
AI_AUDIT_ENABLED=true          # writes to OpenSearch index 'malcolm_ai_audit'

# =============================================================================
# Provider config — set the block(s) for whichever provider(s) you'll use.
# Only the block matching AI_DEFAULT_MODEL's provider is strictly required.
# =============================================================================

# --- Ollama (local, host, or remote) ---
#   Malcolm + ollama on same host:
#     OLLAMA_URL=http://localhost:11434
#   Remote ollama:
#     OLLAMA_URL=http://192.0.2.10:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=120              # seconds; cold model loads can exceed 30s
OLLAMA_MODEL=llama3.1:8b        # used by ollama-llama-3_1-8b.yml
OLLAMA_EMBED_MODEL=llama3.1:8b  # used for RAG embeddings

# --- Anthropic (cloud) ---
# ANTHROPIC_API_KEY=

# --- OpenAI (cloud) ---
# OPENAI_API_KEY=
# OPENAI_TIMEOUT=30
